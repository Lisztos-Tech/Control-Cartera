<% content_for :title, "Clientes — #{t('app.nombre')}" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Clientes</h1>
  <%= link_to "+ Nuevo cliente", new_cliente_path,
      class: "text-sm font-medium text-indigo-700 border border-indigo-200 hover:bg-indigo-50 px-3 py-1.5 rounded-lg" %>
</div>

<%= form_with url: clientes_path, method: :get,
      data: { controller: "busqueda", turbo_frame: "tabla_clientes", turbo_action: "advance" }, class: "mb-4" do |f| %>
  <%= f.text_field :q, value: params[:q], placeholder: "Buscar por nombre…",
      data: { action: "input->busqueda#buscar" },
      class: "w-full max-w-md rounded-lg border-gray-300" %>
<% end %>

<%= turbo_frame_tag "tabla_clientes" do %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2">Nombre</th>
          <th class="px-4 py-2">Teléfono</th>
          <th class="px-4 py-2">Email</th>
          <th class="px-4 py-2 text-right">Pólizas vigentes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @clientes.none? %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">Sin clientes.</td></tr>
        <% end %>
        <% @clientes.each do |cliente| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2">
              <%= link_to cliente.nombre, cliente_path(cliente),
                  class: "text-indigo-700 hover:underline font-medium", data: { turbo_frame: "_top" } %>
            </td>
            <td class="px-4 py-2"><%= cliente.telefono.presence || "—" %></td>
            <td class="px-4 py-2"><%= cliente.email.presence || "—" %></td>
            <td class="px-4 py-2 text-right"><%= cliente.polizas_vigentes.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

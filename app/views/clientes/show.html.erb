<% content_for :title, "#{@cliente.nombre} — #{t('app.nombre')}" %>

<div class="flex items-start justify-between mb-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @cliente.nombre %></h1>
    <p class="text-gray-500 mt-1 text-sm">
      <%= @cliente.telefono.present? ? "Tel: #{@cliente.telefono}" : "Sin teléfono" %>
      · <%= @cliente.email.presence || "Sin email" %>
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to "+ Nueva póliza", new_poliza_path(cliente_id: @cliente.id),
        class: "text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-lg" %>
    <%= link_to "Editar", edit_cliente_path(@cliente),
        class: "text-sm font-medium text-indigo-700 border border-indigo-200 hover:bg-indigo-50 px-3 py-1.5 rounded-lg" %>
  </div>
</div>

<% if @cliente.notas.present? %>
  <div class="mb-4 bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-2 text-sm text-yellow-900 whitespace-pre-line"><%= @cliente.notas %></div>
<% end %>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <h2 class="font-semibold text-gray-700 px-4 py-3 border-b border-gray-100">Pólizas (<%= @polizas.size %>)</h2>
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th class="px-4 py-2">Póliza</th>
        <th class="px-4 py-2">Aseguradora</th>
        <th class="px-4 py-2">Ramo</th>
        <th class="px-4 py-2">Bien</th>
        <th class="px-4 py-2">Próximo vencimiento</th>
        <th class="px-4 py-2">Estatus</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @polizas.none? %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Sin pólizas.</td></tr>
      <% end %>
      <% @polizas.each do |poliza| %>
        <tr class="hover:bg-gray-50 <%= "opacity-60" unless poliza.estatus_vigente? %>">
          <td class="px-4 py-2">
            <%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza),
                class: "text-indigo-700 hover:underline font-medium" %>
          </td>
          <td class="px-4 py-2"><%= etiqueta_aseguradora(poliza.aseguradora) %></td>
          <td class="px-4 py-2"><%= etiqueta_ramo(poliza.ramo) %></td>
          <td class="px-4 py-2 text-gray-500"><%= poliza.detalle_bien.presence || "—" %></td>
          <td class="px-4 py-2"><%= fecha(poliza.proximo_vencimiento) %></td>
          <td class="px-4 py-2"><%= badge_estatus_poliza(poliza) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% content_for :title, "Editar comisión — #{t('app.nombre')}" %>

<% poliza = @comision.recibo.poliza %>
<h1 class="text-2xl font-bold mb-1">Editar comisión</h1>
<p class="text-gray-500 mb-4">
  Póliza <%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza), class: "text-primary-700 hover:underline" %>
  de <%= poliza.cliente.nombre %> · recibo con vencimiento <%= fecha(@comision.recibo.fecha_vencimiento) %>
</p>

<%= form_with model: @comision, url: comision_path(@comision), class: "bg-white rounded-xl border border-gray-200 p-6 max-w-xl" do |f| %>
  <% if @comision.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% @comision.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :prima_neta, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :prima_neta, step: 0.01, min: 0, class: "w-full rounded-lg border-gray-300" %>
    </div>
    <div>
      <%= f.label :porcentaje, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :porcentaje, step: 0.01, min: 0, max: 100, class: "w-full rounded-lg border-gray-300" %>
    </div>
    <div>
      <%= f.label :monto, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :monto, step: 0.01, min: 0, class: "w-full rounded-lg border-gray-300" %>
      <p class="text-xs text-gray-500 mt-1">Si lo dejas vacío y hay prima y porcentaje, se calcula solo.</p>
    </div>
    <div>
      <%= f.label :estatus, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :estatus, [ [ "Por cobrar", "por_cobrar" ], [ "Pagada", "pagada" ] ], {}, { class: "w-full rounded-lg border-gray-300" } %>
    </div>
    <div>
      <%= f.label :fecha_cobro, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :fecha_cobro, class: "w-full rounded-lg border-gray-300" %>
    </div>
    <div class="col-span-2">
      <%= f.label :notas, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notas, rows: 2, class: "w-full rounded-lg border-gray-300" %>
    </div>
  </div>

  <div class="mt-6 flex gap-3">
    <%= f.submit "Guardar cambios", class: "bg-primary-600 hover:bg-primary-700 text-white font-semibold px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", comisiones_path, class: "text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>
<% end %>

<% content_for :title, "Comisiones — #{t('app.nombre')}" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Comisiones</h1>
  <%= link_to "Exportar a Excel", comisiones_path(format: :xlsx, tab: @tab),
      class: "text-sm font-medium text-primary-700 border border-primary-200 hover:bg-primary-50 px-3 py-1.5 rounded-lg" %>
</div>

<div class="flex gap-1 mb-4 border-b border-gray-200">
  <%= link_to "Por cobrar", comisiones_path(tab: "por_cobrar"),
      class: "px-4 py-2 text-sm font-medium rounded-t-lg #{@tab == 'por_cobrar' ? 'bg-white border border-b-white border-gray-200 text-primary-700 -mb-px' : 'text-gray-500 hover:text-gray-800'}" %>
  <%= link_to "Pagadas", comisiones_path(tab: "pagadas"),
      class: "px-4 py-2 text-sm font-medium rounded-t-lg #{@tab == 'pagadas' ? 'bg-white border border-b-white border-gray-200 text-primary-700 -mb-px' : 'text-gray-500 hover:text-gray-800'}" %>
</div>

<% if @tab == "por_cobrar" %>
  <% if @grupos.none? %>
    <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-400">Sin comisiones por cobrar.</div>
  <% end %>
  <% @grupos.each do |grupo, comisiones| %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-x-auto mb-6">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-gray-50">
        <h2 class="font-semibold text-gray-700">
          <% tipo, valor = grupo.split("_", 2) %>
          <% if tipo == "broker" %>
            <%= valor.present? ? etiqueta_broker(valor) : "Broker (sin identificar)" %>
          <% else %>
            <span class="inline-flex items-center gap-1.5">
              <span>Directo —</span>
              <%= badge_aseguradora(valor) %>
            </span>
          <% end %>
        </h2>
        <p class="text-sm font-bold text-gray-800">
          Total: <%= moneda(comisiones.sum { |c| c.monto || 0 }) %>
        </p>
      </div>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-2">Cliente</th>
            <th class="px-4 py-2">Póliza</th>
            <th class="px-4 py-2">Vence</th>
            <th class="px-4 py-2 text-right">Prima neta</th>
            <th class="px-4 py-2 text-right">%</th>
            <th class="px-4 py-2 text-right">Comisión</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% comisiones.each do |comision| %>
            <% poliza = comision.recibo.poliza %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2"><%= link_to poliza.cliente.nombre, cliente_path(poliza.cliente), class: "text-primary-700 hover:underline" %></td>
              <td class="px-4 py-2"><%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza), class: "text-primary-700 hover:underline" %></td>
              <td class="px-4 py-2 whitespace-nowrap"><%= fecha(comision.recibo.fecha_vencimiento) %></td>
              <td class="px-4 py-2 text-right"><%= moneda(comision.prima_neta) %></td>
              <td class="px-4 py-2 text-right"><%= comision.porcentaje ? "#{comision.porcentaje.to_f}%" : "—" %></td>
              <td class="px-4 py-2 text-right font-medium"><%= moneda(comision.monto) %></td>
              <td class="px-4 py-2 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1">
                  <%= enlace_editar edit_comision_path(comision), titulo: "Editar comisión" %>
                  <%= button_to "Marcar pagada", marcar_pagada_comision_path(comision), method: :patch,
                      class: "text-xs font-semibold text-white bg-green-600 hover:bg-green-700 px-3 py-1.5 rounded-lg inline-block cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2">Cliente</th>
          <th class="px-4 py-2">Póliza</th>
          <th class="px-4 py-2">Broker / Canal</th>
          <th class="px-4 py-2 text-right">Comisión</th>
          <th class="px-4 py-2">Cobrada el</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @comisiones.none? %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Sin comisiones pagadas.</td></tr>
        <% end %>
        <% @comisiones.each do |comision| %>
          <% poliza = comision.recibo.poliza %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2"><%= link_to poliza.cliente.nombre, cliente_path(poliza.cliente), class: "text-primary-700 hover:underline" %></td>
            <td class="px-4 py-2"><%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza), class: "text-primary-700 hover:underline" %></td>
            <td class="px-4 py-2">
              <% if poliza.broker.present? %>
                <%= etiqueta_broker(poliza.broker) %>
              <% else %>
                <span class="inline-flex items-center gap-1.5">
                  <span>Directo —</span>
                  <%= badge_aseguradora(poliza.aseguradora) %>
                </span>
              <% end %>
            </td>
            <td class="px-4 py-2 text-right font-medium"><%= moneda(comision.monto) %></td>
            <td class="px-4 py-2"><%= fecha(comision.fecha_cobro) %></td>
            <td class="px-4 py-2 text-right">
              <%= enlace_editar edit_comision_path(comision), titulo: "Editar comisión" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/paginacion", pagy: @pagy %>
  </div>
<% end %>

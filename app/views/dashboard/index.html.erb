<% content_for :title, "Vencimientos — #{t('app.nombre')}" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Vencimientos</h1>
  <%= link_to "Exportar a Excel", root_path(format: :xlsx, **@filtro.to_params),
      class: "text-sm font-medium text-indigo-700 border border-indigo-200 hover:bg-indigo-50 px-3 py-1.5 rounded-lg" %>
</div>

<div class="grid grid-cols-3 gap-4 mb-6" id="contadores">
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-sm text-gray-500">Vencidos</p>
    <p class="text-3xl font-bold text-red-600"><%= @vencidos %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-sm text-gray-500">Vencen esta semana</p>
    <p class="text-3xl font-bold text-amber-500"><%= @esta_semana %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-sm text-gray-500">Vencen este mes</p>
    <p class="text-3xl font-bold text-gray-800"><%= @este_mes %></p>
  </div>
</div>

<%= form_with url: root_path, method: :get,
      data: { controller: "busqueda", turbo_frame: "tabla_recibos", turbo_action: "advance" },
      class: "bg-white rounded-xl border border-gray-200 p-4 mb-4 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 items-end" do |f| %>
  <div class="col-span-2">
    <%= f.label :q, "Buscar", class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= f.text_field :q, value: @filtro.q, placeholder: "Cliente o número de póliza",
        data: { action: "input->busqueda#buscar" },
        class: "w-full rounded-lg border-gray-300 text-sm" %>
  </div>
  <div>
    <%= f.label :aseguradora, class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= f.select :aseguradora, opciones_aseguradora, { include_blank: "Todas", selected: @filtro.aseguradora },
        { data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" } %>
  </div>
  <div>
    <%= f.label :canal, class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= f.select :canal, opciones_canal, { include_blank: "Todos", selected: @filtro.canal },
        { data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" } %>
  </div>
  <div>
    <%= f.label :broker, class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= f.select :broker, opciones_broker, { include_blank: "Todos", selected: @filtro.broker },
        { data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" } %>
  </div>
  <div>
    <%= f.label :ramo, class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= f.select :ramo, opciones_ramo, { include_blank: "Todos", selected: @filtro.ramo },
        { data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" } %>
  </div>
  <div class="flex gap-2 col-span-2 lg:col-span-1">
    <div>
      <%= f.label :desde, "Desde", class: "block text-xs font-medium text-gray-500 mb-1" %>
      <%= f.date_field :desde, value: @filtro.desde,
          data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <div>
      <%= f.label :hasta, "Hasta", class: "block text-xs font-medium text-gray-500 mb-1" %>
      <%= f.date_field :hasta, value: @filtro.hasta,
          data: { action: "change->busqueda#enviar" }, class: "w-full rounded-lg border-gray-300 text-sm" %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "tabla_recibos" do %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-3 py-2 w-8"></th>
          <th class="px-3 py-2">Vence</th>
          <th class="px-3 py-2">Cliente</th>
          <th class="px-3 py-2">Póliza</th>
          <th class="px-3 py-2">Aseguradora</th>
          <th class="px-3 py-2">Ramo</th>
          <th class="px-3 py-2">Bien</th>
          <th class="px-3 py-2 text-right">Importe</th>
          <th class="px-3 py-2">Pago</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody id="recibos" class="divide-y divide-gray-100">
        <% if @recibos.none? %>
          <tr><td colspan="10" class="px-3 py-8 text-center text-gray-400">Sin recibos pendientes con estos filtros.</td></tr>
        <% end %>
        <%= render partial: "dashboard/recibo", collection: @recibos %>
      </tbody>
    </table>
  </div>
<% end %>

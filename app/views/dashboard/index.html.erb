<% content_for :title, "Inicio — #{t('app.nombre')}" %>

<h1 class="text-2xl font-bold mb-6">Hola, <%= Current.user.nombre.presence || Current.user.nombre_completo %></h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <%= link_to vencimientos_path(hasta: Date.yesterday),
      class: "block bg-white rounded-xl border border-gray-200 p-6 hover:border-red-300 hover:shadow-sm transition" do %>
    <p class="text-sm text-gray-500">Vencidos</p>
    <p class="text-4xl font-bold text-red-600 mt-1"><%= @vencidos %></p>
    <p class="text-xs text-gray-400 mt-2">Recibos pendientes con fecha vencida</p>
  <% end %>

  <%= link_to vencimientos_path(desde: Date.current, hasta: Date.current.end_of_week),
      class: "block bg-white rounded-xl border border-gray-200 p-6 hover:border-amber-300 hover:shadow-sm transition" do %>
    <p class="text-sm text-gray-500">Vencen esta semana</p>
    <p class="text-4xl font-bold text-amber-500 mt-1"><%= @esta_semana %></p>
    <p class="text-xs text-gray-400 mt-2">De hoy al domingo</p>
  <% end %>

  <%= link_to vencimientos_path(desde: Date.current, hasta: Date.current.end_of_month),
      class: "block bg-white rounded-xl border border-gray-200 p-6 hover:border-primary-300 hover:shadow-sm transition" do %>
    <p class="text-sm text-gray-500">Vencen este mes</p>
    <p class="text-4xl font-bold text-gray-800 mt-1"><%= @este_mes %></p>
    <p class="text-xs text-gray-400 mt-2">De hoy a fin de mes</p>
  <% end %>
</div>

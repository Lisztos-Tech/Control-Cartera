<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || t("app.nombre") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen text-gray-900">
    <% if authenticated? %>
    <aside class="fixed inset-y-0 left-0 w-60 bg-primary-900 text-white flex flex-col z-10">
      <div class="px-5 py-5 border-b border-white/10">
        <%= link_to t("app.nombre"), root_path, class: "font-bold text-lg text-white leading-tight" %>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1 text-sm font-medium">
        <%= enlace_sidebar "Inicio", root_path, activo: request.path == root_path %>
        <%= enlace_sidebar "Vencimientos", vencimientos_path, activo: request.path == vencimientos_path %>
        <%= enlace_sidebar "Clientes", clientes_path, activo: request.path.start_with?(clientes_path) %>
        <%= enlace_sidebar "Comisiones", comisiones_path, activo: request.path.start_with?(comisiones_path) %>
        <%= enlace_sidebar "Canceladas", canceladas_polizas_path, activo: request.path == canceladas_polizas_path %>
        <% pendientes_revision = Poliza.necesitan_revision.count %>
        <% if pendientes_revision.positive? %>
          <%= enlace_sidebar revision_polizas_path, activo: request.path == revision_polizas_path do %>
            <span class="flex items-center justify-between">
              Necesitan revisión
              <span class="bg-red-500 text-white rounded-full px-2 py-0.5 text-xs font-bold"><%= pendientes_revision %></span>
            </span>
          <% end %>
        <% end %>
      </nav>

      <div class="px-3 py-4 border-t border-white/10 space-y-2">
        <%= link_to "+ Nueva póliza", new_poliza_path,
            class: "block text-center bg-white text-primary-800 hover:bg-primary-100 text-sm font-semibold px-4 py-2 rounded-lg" %>
        <%= button_to "Salir", session_path, method: :delete,
            class: "w-full text-sm text-primary-300 hover:text-white cursor-pointer py-1" %>
      </div>
    </aside>

    <div class="ml-60 min-h-screen flex flex-col">
      <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-end gap-3 sticky top-0 z-10">
        <span class="w-8 h-8 rounded-full bg-primary-100 text-primary-800 font-bold flex items-center justify-center text-sm">
          <%= Current.user.inicial %>
        </span>
        <span class="text-sm text-gray-700"><%= Current.user.nombre_completo %></span>
      </header>

      <main class="px-6 py-6 flex-1">
        <%= render "shared/flashes" %>
        <%= yield %>
      </main>
    </div>
    <% else %>

    <main class="max-w-7xl mx-auto px-4 py-6">
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>
    <% end %>
  </body>
</html>

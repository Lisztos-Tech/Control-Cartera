<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || t("app.nombre") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen text-gray-900">
    <% if authenticated? %>
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <nav class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-6">
        <%= link_to t("app.nombre"), root_path, class: "font-bold text-lg text-indigo-700" %>

        <div class="flex items-center gap-4 text-sm font-medium text-gray-600">
          <%= link_to "Vencimientos", root_path, class: "hover:text-indigo-700" %>
          <%= link_to "Clientes", clientes_path, class: "hover:text-indigo-700" %>
          <%= link_to "Comisiones", comisiones_path, class: "hover:text-indigo-700" %>
          <%= link_to "Canceladas", canceladas_polizas_path, class: "hover:text-indigo-700" %>
          <% pendientes_revision = Poliza.necesitan_revision.count %>
          <% if pendientes_revision.positive? %>
            <%= link_to revision_polizas_path, class: "hover:text-indigo-700 flex items-center gap-1" do %>
              Necesitan revisión
              <span class="bg-red-100 text-red-700 rounded-full px-2 py-0.5 text-xs font-bold"><%= pendientes_revision %></span>
            <% end %>
          <% end %>
        </div>

        <div class="ml-auto flex items-center gap-3">
          <%= link_to "+ Nueva póliza", new_poliza_path,
              class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-lg" %>
          <%= button_to "Salir", session_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-800 cursor-pointer" %>
        </div>
      </nav>
    </header>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 py-6">
      <% if notice %>
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-2 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-2 text-sm"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>

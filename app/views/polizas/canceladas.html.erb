<% content_for :title, "Canceladas — #{t('app.nombre')}" %>

<h1 class="text-2xl font-bold mb-4">Canceladas / histórico</h1>

<%= form_with url: canceladas_polizas_path, method: :get,
      data: { controller: "busqueda", turbo_frame: "tabla_canceladas", turbo_action: "advance" }, class: "mb-4" do |f| %>
  <%= f.text_field :q, value: params[:q], placeholder: "Buscar por cliente o número de póliza…",
      data: { action: "input->busqueda#buscar" },
      class: "w-full max-w-md rounded-lg border-gray-300" %>
<% end %>

<%= turbo_frame_tag "tabla_canceladas" do %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2">Póliza</th>
          <th class="px-4 py-2">Cliente</th>
          <th class="px-4 py-2">Aseguradora</th>
          <th class="px-4 py-2">Ramo</th>
          <th class="px-4 py-2">Estatus</th>
          <th class="px-4 py-2">Motivo</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @polizas.none? %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">Sin pólizas canceladas.</td></tr>
        <% end %>
        <% @polizas.each do |poliza| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2">
              <%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza),
                  class: "text-primary-700 hover:underline font-medium", data: { turbo_frame: "_top" } %>
            </td>
            <td class="px-4 py-2"><%= poliza.cliente.nombre %></td>
            <td class="px-4 py-2"><%= badge_aseguradora(poliza.aseguradora) %></td>
            <td class="px-4 py-2"><%= etiqueta_ramo(poliza.ramo) %></td>
            <td class="px-4 py-2"><%= badge_estatus_poliza(poliza) %></td>
            <td class="px-4 py-2 text-gray-500 max-w-64 truncate" title="<%= poliza.motivo_cancelacion %>"><%= poliza.motivo_cancelacion.presence || "—" %></td>
            <td class="px-4 py-2 text-right">
              <%= button_to "Reactivar", reactivar_poliza_path(poliza), method: :patch,
                  form: { data: { turbo_frame: "_top", turbo_confirm: "¿Reactivar esta póliza como vigente?" } },
                  class: "text-xs font-medium text-green-700 border border-green-300 hover:bg-green-50 px-2 py-1 rounded-lg cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/paginacion", pagy: @pagy %>
  </div>
<% end %>

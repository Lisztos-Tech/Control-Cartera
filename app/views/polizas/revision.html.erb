<% content_for :title, "Necesitan revisión — #{t('app.nombre')}" %>

<h1 class="text-2xl font-bold mb-1">Necesitan revisión (<%= @polizas.size %>)</h1>
<p class="text-gray-500 mb-4 text-sm">
  Pólizas flaggeadas por el importador. Al editar y guardar una póliza, el flag se limpia.
</p>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th class="px-4 py-2">Póliza</th>
        <th class="px-4 py-2">Cliente</th>
        <th class="px-4 py-2">Aseguradora</th>
        <th class="px-4 py-2">Motivo de revisión</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @polizas.none? %>
        <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">Nada pendiente de revisar.</td></tr>
      <% end %>
      <% @polizas.each do |poliza| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2">
            <%= link_to poliza.numero_poliza || "s/n", poliza_path(poliza),
                class: "text-indigo-700 hover:underline font-medium" %>
          </td>
          <td class="px-4 py-2"><%= poliza.cliente.nombre %></td>
          <td class="px-4 py-2"><%= etiqueta_aseguradora(poliza.aseguradora) %></td>
          <td class="px-4 py-2 text-red-700"><%= poliza.motivo_revision %></td>
          <td class="px-4 py-2 text-right">
            <%= link_to "Revisar y editar", edit_poliza_path(poliza),
                class: "text-xs font-medium text-indigo-700 border border-indigo-200 hover:bg-indigo-50 px-2 py-1 rounded-lg" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

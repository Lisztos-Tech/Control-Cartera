<% content_for :title, "Póliza #{@poliza.numero_poliza || 's/n'} — #{t('app.nombre')}" %>

<div class="flex items-start justify-between mb-4">
  <div>
    <h1 class="text-2xl font-bold flex items-center gap-3">
      Póliza <%= @poliza.numero_poliza || "s/n" %>
      <%= badge_estatus_poliza(@poliza) %>
      <% if @poliza.necesita_revision? %>
        <span class="bg-red-100 text-red-700 rounded-full px-2 py-0.5 text-xs font-bold">Necesita revisión</span>
      <% end %>
    </h1>
    <p class="text-gray-500 mt-1">
      <%= link_to @poliza.cliente.nombre, cliente_path(@poliza.cliente), class: "text-primary-700 hover:underline font-medium" %>
      · <%= badge_aseguradora(@poliza.aseguradora) %>
      · <%= etiqueta_canal(@poliza.canal) %><%= " (#{etiqueta_broker(@poliza.broker)})" if @poliza.broker.present? %>
    </p>
  </div>
  <div class="flex gap-2">
    <% unless @poliza.estatus_vigente? %>
      <%= button_to "Reactivar", reactivar_poliza_path(@poliza), method: :patch,
          class: "text-sm font-medium text-green-700 border border-green-300 hover:bg-green-50 px-3 py-1.5 rounded-lg cursor-pointer" %>
    <% end %>
    <%= link_to "Editar", edit_poliza_path(@poliza),
        class: "text-sm font-medium text-primary-700 border border-primary-200 hover:bg-primary-50 px-3 py-1.5 rounded-lg" %>
  </div>
</div>

<% if @poliza.posible_duplicado? %>
  <div class="mb-4 rounded-lg bg-amber-50 border border-amber-300 text-amber-800 px-4 py-2 text-sm">
    Aviso: existe otra póliza con el mismo número y aseguradora. Verifica que no sea un duplicado.
  </div>
<% end %>

<% if @poliza.necesita_revision? && @poliza.motivo_revision.present? %>
  <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-2 text-sm">
    <strong>Motivo de revisión:</strong> <%= @poliza.motivo_revision %>
    <span class="text-red-500">(al editar y guardar la póliza, el flag se limpia)</span>
  </div>
<% end %>

<div class="grid md:grid-cols-3 gap-4 mb-6">
  <div class="md:col-span-2 bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="font-semibold text-gray-700 mb-3">Datos de la póliza</h2>
    <dl class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3 text-sm">
      <div><dt class="text-gray-500">Ramo</dt><dd class="font-medium"><%= etiqueta_ramo(@poliza.ramo) %></dd></div>
      <div><dt class="text-gray-500">Cobertura</dt><dd class="font-medium"><%= @poliza.cobertura.presence || "—" %></dd></div>
      <div><dt class="text-gray-500">Forma de pago</dt><dd class="font-medium"><%= etiqueta_forma_pago(@poliza.forma_pago) %></dd></div>
      <div><dt class="text-gray-500">Prima total</dt><dd class="font-medium"><%= moneda(@poliza.prima_total, @poliza.moneda) %></dd></div>
      <div><dt class="text-gray-500">Moneda</dt><dd class="font-medium"><%= t("app.monedas.#{@poliza.moneda}") %></dd></div>
      <div><dt class="text-gray-500">Clave de agente</dt><dd class="font-medium"><%= @poliza.clave_agente.presence || "—" %></dd></div>
      <div class="col-span-2"><dt class="text-gray-500">Bien asegurado</dt><dd class="font-medium"><%= @poliza.detalle_bien.presence || "—" %></dd></div>
      <div class="col-span-2"><dt class="text-gray-500">Observaciones</dt><dd class="font-medium"><%= @poliza.observaciones.presence || "—" %></dd></div>
      <div><dt class="text-gray-500">Próximo vencimiento</dt><dd class="font-medium"><%= fecha(@poliza.proximo_vencimiento) %></dd></div>
      <% if @poliza.motivo_cancelacion.present? %>
        <div class="col-span-3"><dt class="text-gray-500">Motivo de cancelación</dt><dd class="font-medium text-red-700"><%= @poliza.motivo_cancelacion %></dd></div>
      <% end %>
    </dl>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="font-semibold text-gray-700 mb-2">Notas</h2>
    <p class="text-sm text-gray-600 whitespace-pre-line"><%= @poliza.notas.presence || "Sin notas." %></p>
  </div>
</div>

<div class="bg-white rounded-xl border border-gray-200 overflow-x-auto">
  <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
    <h2 class="font-semibold text-gray-700">Recibos</h2>
    <%= link_to "+ Agregar recibo", new_poliza_recibo_path(@poliza),
        class: "text-sm font-medium text-primary-700 hover:underline" %>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th class="px-3 py-2 w-8"></th>
        <th class="px-3 py-2">Recibo</th>
        <th class="px-3 py-2">Vence</th>
        <th class="px-3 py-2 text-right">Importe</th>
        <th class="px-3 py-2">Pagado el</th>
        <th class="px-3 py-2">Estatus</th>
        <th class="px-3 py-2">Comisión</th>
        <th class="px-3 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @recibos.none? %>
        <tr><td colspan="8" class="px-3 py-6 text-center text-gray-400">Sin recibos.</td></tr>
      <% end %>
      <% @recibos.each do |recibo| %>
        <tr id="<%= dom_id(recibo) %>" class="hover:bg-gray-50">
          <td class="px-3 py-2"><%= semaforo_punto(recibo) if recibo.estatus_pendiente? %></td>
          <td class="px-3 py-2"><%= recibo.numero_recibo.presence || "—" %></td>
          <td class="px-3 py-2 whitespace-nowrap <%= "text-red-600 font-medium" if recibo.vencido? %>"><%= fecha(recibo.fecha_vencimiento) %></td>
          <td class="px-3 py-2 text-right whitespace-nowrap"><%= moneda(recibo.importe, @poliza.moneda) %></td>
          <td class="px-3 py-2 whitespace-nowrap"><%= fecha(recibo.fecha_pago) %></td>
          <td class="px-3 py-2">
            <% if recibo.estatus_pagado? %>
              <span class="text-green-700 font-medium">Pagado</span>
            <% elsif recibo.vencido? %>
              <span class="text-red-600 font-medium">Vencido</span>
            <% else %>
              <span class="text-gray-600">Pendiente</span>
            <% end %>
          </td>
          <td class="px-3 py-2 text-xs">
            <% if recibo.comision %>
              <%= moneda(recibo.comision.monto) %> · <%= etiqueta_estatus_comision(recibo.comision.estatus) %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="px-3 py-2 text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-1">
              <% if recibo.estatus_pendiente? %>
                <%= button_to "Marcar pagado", marcar_pagado_recibo_path(recibo), method: :patch,
                    class: "text-xs font-semibold text-white bg-green-600 hover:bg-green-700 px-3 py-1.5 rounded-lg inline-block cursor-pointer mr-1" %>
              <% end %>
              <%= enlace_editar edit_recibo_path(recibo), titulo: "Editar recibo" %>
              <%= boton_borrar recibo_path(recibo), titulo: "Borrar recibo",
                  confirmacion: "¿Borrar este recibo? Esta acción no se puede deshacer." %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

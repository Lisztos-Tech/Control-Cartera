<%= turbo_stream.replace dom_id(@recibo) do %>
  <tr id="<%= dom_id(@recibo) %>" class="bg-primary-50">
    <td class="px-3 py-2"><span class="inline-block h-3 w-3 rounded-full bg-primary-500"></span></td>
    <td class="px-3 py-3" colspan="9">
      <span class="font-medium text-primary-800">
        Siguiente recibo creado: vence el <%= fecha(@nuevo.fecha_vencimiento) %>
        por <%= moneda(@nuevo.importe, @nuevo.poliza.moneda) %>.
      </span>
    </td>
  </tr>
<% end %>

<% content_for :title, "Editar recibo — #{t('app.nombre')}" %>
<h1 class="text-2xl font-bold mb-1">Editar recibo</h1>
<p class="text-gray-500 mb-4">
  Póliza <%= @recibo.poliza.numero_poliza || "s/n" %> de <%= @recibo.poliza.cliente.nombre %>
</p>
<%= render "form", recibo: @recibo, url: recibo_path(@recibo), metodo: :patch %>

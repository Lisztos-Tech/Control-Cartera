<% content_for :title, "Nuevo recibo — #{t('app.nombre')}" %>
<h1 class="text-2xl font-bold mb-1">Nuevo recibo</h1>
<p class="text-gray-500 mb-4">
  Póliza <%= @poliza.numero_poliza || "s/n" %> de <%= @poliza.cliente.nombre %>
</p>
<%= render "form", recibo: @recibo, url: poliza_recibos_path(@poliza), metodo: :post %>

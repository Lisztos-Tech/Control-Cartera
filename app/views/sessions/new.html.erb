<% content_for :title, "Entrar — #{t('app.nombre')}" %>

<div class="max-w-sm mx-auto mt-16">
  <div class="bg-white rounded-xl border border-gray-200 p-8">
    <h1 class="font-bold text-2xl mb-6 text-center"><%= t("app.nombre") %></h1>

    <%= form_with url: session_url do |f| %>
      <div class="mb-4">
        <%= f.label :email_address, "Correo electrónico", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address], class: "w-full rounded-lg border-gray-300" %>
      </div>
      <div class="mb-6">
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "w-full rounded-lg border-gray-300" %>
      </div>
      <%= f.submit "Entrar", class: "w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold px-4 py-2.5 rounded-lg cursor-pointer" %>
    <% end %>
  </div>
</div>

<% content_for :title, "Entrar — #{t('app.nombre')}" %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
    <div class="grid min-h-[32rem] lg:grid-cols-2">
      <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-12">
        <div class="mb-8">
          <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sesion.titulo") %></h1>
          <p class="mt-2 text-sm text-gray-500"><%= t("sesion.subtitulo", app: t("app.nombre")) %></p>
        </div>

        <%= form_with url: session_url, class: "space-y-5" do |f| %>
          <div>
            <%= f.label :email_address, t("sesion.email"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                value: params[:email_address], placeholder: t("sesion.email_placeholder"),
                class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
          </div>

          <div>
            <%= f.label :password, t("sesion.password"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
                class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
          </div>

          <%= f.submit t("sesion.entrar"),
              class: "w-full rounded-md bg-primary-900 hover:bg-primary-800 text-white text-sm font-medium py-2.5 cursor-pointer shadow-sm transition-colors" %>
        <% end %>
      </div>

      <div class="relative hidden overflow-hidden bg-gray-100 lg:flex lg:flex-col lg:items-center lg:justify-center lg:p-12">
        <div class="absolute inset-0 opacity-[0.35]"
             style="background-image: radial-gradient(circle at 1px 1px, rgb(156 163 175) 1px, transparent 0); background-size: 24px 24px;"></div>

        <div class="relative flex flex-col items-center text-center">
          <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-full border border-gray-300 bg-white shadow-sm">
            <%= image_tag "/icon.svg", alt: "", class: "h-12 w-12" %>
          </div>
          <p class="text-xl font-semibold text-primary-900"><%= t("app.nombre") %></p>
          <p class="mt-2 max-w-xs text-sm text-gray-500"><%= t("sesion.descripcion") %></p>
        </div>
      </div>
    </div>
  </div>

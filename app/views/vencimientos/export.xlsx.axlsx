wb = xlsx_package.workbook

wb.add_worksheet(name: "Vencimientos") do |hoja|
  encabezado = wb.styles.add_style(b: true, bg_color: "E5E7EB")
  fecha_estilo = wb.styles.add_style(format_code: "dd/mm/yyyy")
  dinero = wb.styles.add_style(format_code: "$#,##0.00")

  hoja.add_row [ "Vence", "Cliente", "Póliza", "Aseguradora", "Canal", "Broker", "Ramo",
                 "Tipo", "Observaciones", "Importe", "Moneda", "Forma de pago", "Estatus" ], style: encabezado

  @recibos.each do |recibo|
    poliza = recibo.poliza
    hoja.add_row [
      recibo.fecha_vencimiento,
      poliza.cliente.nombre,
      poliza.numero_poliza,
      t("app.aseguradoras.#{poliza.aseguradora}"),
      t("app.canales.#{poliza.canal}"),
      poliza.broker.present? ? t("app.brokers.#{poliza.broker}") : nil,
      t("app.ramos.#{poliza.ramo}"),
      poliza.detalle_bien,
      poliza.observaciones,
      recibo.importe&.to_f,
      poliza.moneda.upcase,
      t("app.formas_pago.#{poliza.forma_pago}"),
      recibo.vencido? ? "Vencido" : "Pendiente"
    ], style: [ fecha_estilo, nil, nil, nil, nil, nil, nil, nil, nil, dinero, nil, nil, nil ]
  end

  hoja.column_widths 12, 34, 14, 14, 10, 14, 10, 28, 24, 12, 8, 12, 10
end
